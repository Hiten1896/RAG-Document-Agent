# ─── Required ───────────────────────────────────────────────────────────────
# Google Gemini API key, used to generate answers.
# GEMINI_API_KEYS (comma-separated) also works and enables key rotation on quota
# errors; GOOGLE_API_KEY and GEMINI_API_KEY are accepted as single-key aliases.
GOOGLE_API_KEY=your_gemini_api_key_here

# Jina embeddings API key (https://jina.ai/embeddings). Required for both upload
# and query — without it the API answers 503.
JINA_API_KEY=your_jina_api_key_here

# ─── Optional ───────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API, e.g. the
# Vercel deployment URL. Set this in production: when it is empty the server
# falls back to allowing any origin with credentials disabled.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Read CA certificates from the OS trust store instead of certifi's bundle.
# Set this to true if outbound HTTPS fails with CERTIFICATE_VERIFY_FAILED on a
# machine whose antivirus or corporate proxy inspects TLS (Avast, Zscaler,
# Kaspersky). Leave unset on Render.
# USE_SYSTEM_CERT_STORE=true

# Gemini models are tried in order; GEMINI_MODEL, when set, is always first.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_API_KEYS=key_from_project_1,key_from_project_2
# set slightly below the limit shown in AI Studio > Rate Limit
GEMINI_MODEL_RPM=gemini-3.5-flash-lite:12,gemini-3.8-flash:4
GEMINI_MODEL_RPD=gemini-3.5-flash-lite:450,gemini-3.8-flash:18
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_ROUTE_TEXT=groq,gemini
LLM_ROUTE_VISUAL=gemini,groq
GROQ_MAX_CONTEXT_CHARS=12000
PROMPT_VERSION=strict

# Ingestion limits and tuning.
# MAX_UPLOAD_MB=25
# MAX_CHUNKS_PER_DOC=1500
# JINA_BATCH_SIZE=64
# JINA_MAX_WORKERS=4

# Seconds of inactivity before a chat's vectors are purged from memory.
# SESSION_TTL_SECONDS=1800
